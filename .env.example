GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# APP_URL: The public base URL where this applet is hosted (e.g. Cloud Run, Railway, Vercel)
APP_URL="https://your-domain.example.com"

# FIREBASE CONFIGURATION (Backend-provided or local fallback)
# In production, these can be set as backend environment variables so client credentials
# are delivered securely without requiring static hardcoded config files.
