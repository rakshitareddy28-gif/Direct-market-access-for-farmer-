# NOTE: Never commit sensitive keys or credentials to version control.
# Copy this file to .env for local testing or configure these in your deployment platform.

# Node Server Port
PORT=3000

# Environment Mode ('development' | 'production')
NODE_ENV="production"

# GEMINI_API_KEY: Required for server-side Gemini AI Agronomist & Harvest Concierge
