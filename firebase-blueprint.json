{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with direct market account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "preferredDeliveryAddress": { "type": "string", "maxLength": 256 }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer produce harvest orders with direct farmer disbursement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "items": { "type": "array" },
        "totalRupees": { "type": "number" },
        "farmerPayoutRupees": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "destinationAddress": { "type": "string", "maxLength": 256 },
        "deliverySlot": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "totalRupees", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders record"
    }
  }
}
